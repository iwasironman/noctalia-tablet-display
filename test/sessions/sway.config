# Minimal sway session for testing the Tablet Display plugin.
# Test by logging out of your usual session and choosing this one in the
# greeter. Don't run it alongside another session on a second TTY: they share
# your user systemd, and mango stops graphical-session.target when it exits,
# which ends the other session too.
# Copy to ~/.config/sway/config. Log out from Noctalia's session menu, or
# Super+Shift+E.

set $mod Mod4

# Give the Sunshine service this session's display, not niri's.
exec systemctl --user unset-environment NIRI_SOCKET HYPRLAND_INSTANCE_SIGNATURE
exec systemctl --user import-environment WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP
exec noctalia

set $ipc noctalia msg
bindsym $mod+Return exec ghostty
bindsym $mod+space exec $ipc panel-toggle launcher
bindsym $mod+s exec $ipc panel-toggle control-center
bindsym $mod+q kill
bindsym $mod+Shift+e exit
